{
  "name": "octoliner-mapdiver",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev:init:db-bare": "docker compose -f docker-compose.dev.yml -p dev up db",
    "dev:init:db": "docker compose -f docker-compose.dev.yml -p dev up db && docker compose -f docker-compose.dev.yml -p dev up json_loader",
    "dev:up": "docker compose -f docker-compose.dev.yml -p dev up",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:lint": "eslint resources/ --fix",
    "check:lint:dry_run": "eslint resources/",
    "check:prettier": "prettier resources/ --write",
    "check:prettier:dry_run": "prettier resources/ --check",
    "test:unitary": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^25.9.9",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-svelte": "^3.23.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.9.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "pg": "^8.23.1",
    "prettier-plugin-svelte": "^4.1.1"
  }
}
