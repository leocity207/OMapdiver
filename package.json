{
  "name": "octoliner-mapdiver",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev:init:db-bare": "docker compose -f docker-compose.dev.yml -p dev up db",
    "dev:init:db": "docker compose -f docker-compose.dev.yml -p dev up db && docker compose -f docker-compose.dev.yml -p dev up json_loader",
    "dev:up": "docker compose -f docker-compose.dev.yml -p dev up",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:lint": "eslint resources/",
    "check:lint:fix": "eslint resources/ --fix",
    "check:prettier": "prettier resources/ --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/hammerjs": "^2.0.46",
    "@types/normalize-wheel": "^1.0.4",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-svelte": "^3.19.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "svelte": "^5.56.2",
    "svelte-check": "^4.6.0",
    "svelte-eslint-parser": "^1.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "animejs": "^4.4.1",
    "fabric": "^6.9.1",
    "hammerjs": "^2.0.8",
    "normalize-wheel": "^1.0.1",
    "pg": "^8.21.0",
    "rxjs": "^7.8.2"
  }
}